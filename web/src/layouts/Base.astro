---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getData } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Search every Oakhouse share house, social residence and apartment by area or train line.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const { meta } = getData();
const updated = meta.updated
  ? new Date(meta.updated).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Tokyo' }) + ' JST'
  : 'not yet';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Set html.dark before first paint (no flash): the saved choice if any, else the OS setting.
      let t = null;
      try {
        t = localStorage.getItem('theme');
      } catch {}
      if (t !== 'light' && t !== 'dark') t = null;
      if (t) document.documentElement.dataset.theme = t;
      document.documentElement.classList.toggle('dark', t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches);
    </script>
    <title>{title ? `${title} · Oakhouse Search` : 'Oakhouse Search'}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="min-h-screen">
    <header class="site-header border-b bg-background/95 backdrop-blur">
      <div class="wrap flex min-h-14 items-center gap-4">
        <a class="brand flex items-center gap-2 font-semibold text-foreground" href={base}>
          <span class="flex size-7 items-center justify-center rounded-md bg-primary text-primary-foreground" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /></svg>
          </span>
          Oakhouse Search
        </a>
        <nav class="site-nav flex gap-1" aria-label="Main">
          <a class="btn" data-variant="ghost" data-size="sm" href={`${base}search/area/`}>By area</a>
          <a class="btn" data-variant="ghost" data-size="sm" href={`${base}search/line/`}>By line &amp; station</a>
          <a class="btn" data-variant="ghost" data-size="sm" href={`${base}search/commute/`}>By commute</a>
          <a class="btn" data-variant="ghost" data-size="sm" href={`${base}results/`}>All listings</a>
        </nav>
        <button class="btn theme-toggle ml-auto" data-variant="ghost" data-size="icon" type="button" aria-label="Switch to dark mode" title="Switch to dark mode">
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </div>
    </header>
    <main class="wrap py-8">
      <slot />
    </main>
    <footer class="mt-16 border-t">
      <div class="wrap space-y-1 py-8 text-sm text-muted-foreground">
        <p>
          An unofficial search for listings from <a class="link" href="https://www.oakhouse.jp/eng/">oakhouse.jp</a>. Prices and
          vacancies change; always confirm on the official page before applying.
        </p>
        <p>Data updated {updated}. Station data © <a class="link" href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>.</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Header light/dark toggle: flips the effective theme and remembers it.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const systemDark = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => root.classList.contains('dark');
  const label = () => {
    const text = isDark() ? 'Switch to light mode' : 'Switch to dark mode';
    button?.setAttribute('aria-label', text);
    button?.setAttribute('title', text);
  };
  button?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    root.classList.toggle('dark', next === 'dark');
    try {
      localStorage.setItem('theme', next);
    } catch {}
    label();
  });
  // Without a saved choice, follow the OS live
  systemDark.addEventListener('change', () => {
    if (!root.dataset.theme) root.classList.toggle('dark', systemDark.matches);
    label();
  });
  label();
</script>
