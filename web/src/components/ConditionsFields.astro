---
// Filter fields shared by /conditions/ and the /results/ sidebar. Values are prefilled from the
// URL by syncFormFromUrl() in lib/form.ts; area/station/line picks are carried as hidden inputs.
import { getData } from '../lib/data';
import { OPERATORS } from '../lib/filter';
import Chevron from './Chevron.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const { amenities } = getData();
// Shown next to the price instead of in the Contract group (they're cost questions).
const COST_KEYS = ['no_key_money', 'no_deposit'];
const costToggles = COST_KEYS.map((key) => amenities.items.find((a) => a.key === key)).filter((a) => a != null);
const groups = Object.entries(amenities.groups).map(([key, label]) => ({
  key,
  label,
  items: amenities.items.filter((a) => a.group === key && !COST_KEYS.includes(a.key)),
}));
const rents = [30000, 40000, 50000, 60000, 70000, 80000, 90000, 100000, 120000, 150000, 200000, 300000];
const k = (n: number) => `¥${(n / 1000).toLocaleString('en-US')}k`;
---

<div data-carry hidden></div>

<div class="flex flex-col gap-6">
  <fieldset class="fieldset">
    <legend>Monthly cost <span class="font-normal text-muted-foreground">(rent + maintenance)</span></legend>
    <div class="flex flex-wrap items-center gap-2">
      <select class="select" name="rmin" aria-label="Minimum monthly cost">
        <option value="">No minimum</option>
        {rents.map((r) => <option value={r}>{k(r)}</option>)}
      </select>
      <span class="text-sm text-muted-foreground">to</span>
      <select class="select" name="rmax" aria-label="Maximum monthly cost">
        <option value="">No maximum</option>
        {rents.map((r) => <option value={r}>{k(r)}</option>)}
      </select>
    </div>
    <div class="checks">
      {costToggles.map((a) => (
        <label class="label"><input class="input" type="checkbox" name="am" value={a!.key} /> {a!.label}</label>
      ))}
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend>Type</legend>
    <div class="checks">
      <label class="label"><input class="input" type="checkbox" name="type" value="share" /> Share house</label>
      <label class="label"><input class="input" type="checkbox" name="type" value="social" /> Social residence</label>
      <label class="label"><input class="input" type="checkbox" name="type" value="flexapt" /> <span>Furnished apartment <span class="text-muted-foreground">(flexible lease)</span></span></label>
      <label class="label"><input class="input" type="checkbox" name="type" value="apartment" /> <span>Apartment <span class="text-muted-foreground">(standard lease)</span></span></label>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend>Share-house room</legend>
    <div class="checks">
      <label class="label"><input class="input" type="checkbox" name="rc" value="private" /> Private room</label>
      <label class="label"><input class="input" type="checkbox" name="rc" value="semi" /> Semi-private</label>
      <label class="label"><input class="input" type="checkbox" name="rc" value="dorm" /> Dormitory</label>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend>Operator</legend>
    <div class="checks">
      {Object.entries(OPERATORS).map(([key, op]) => (
        <label class="label"><input class="input" type="checkbox" name="op" value={key} /> {op.name}</label>
      ))}
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend>Building structure</legend>
    <div class="checks">
      <label class="label"><input class="input" type="checkbox" name="struct" value="wood" /> Wood</label>
      <label class="label"><input class="input" type="checkbox" name="struct" value="steel" /> Steel frame</label>
      <label class="label"><input class="input" type="checkbox" name="struct" value="rc" /> Concrete (RC/SRC)</label>
      <label class="label"><input class="input" type="checkbox" name="struct" value="none" /> Not stated</label>
    </div>
  </fieldset>

  <fieldset class="fieldset">
    <legend>Walk to station</legend>
    <select class="select w-fit" name="walk" aria-label="Maximum walk to station">
      <option value="">Any</option>
      {[5, 7, 10, 15, 20].map((m) => <option value={m}>{m} min or less</option>)}
    </select>
  </fieldset>

  <fieldset class="fieldset">
    <legend>Availability</legend>
    {/* Available + Soon is the default (DEFAULT_AVAIL in lib/filter.ts); the URL omits it */}
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      <label class="label"><input class="input" type="checkbox" name="avail" value="a" checked /> Available</label>
      <label class="label"><input class="input" type="checkbox" name="avail" value="s" checked /> Soon</label>
      <label class="label"><input class="input" type="checkbox" name="avail" value="f" /> Full</label>
    </div>
  </fieldset>

  {
    compact ? (
      <section class="accordion">
        {groups.map((g) => (
          <details>
            <summary>
              {g.label}
              <Chevron />
            </summary>
            <section>
              <div class="checks">
                {g.items.map((a) => (
                  <label class="label">
                    <input class="input" type="checkbox" name="am" value={a.key} /> {a.label}
                  </label>
                ))}
              </div>
            </section>
          </details>
        ))}
      </section>
    ) : (
      groups.map((g) => (
        <fieldset class="fieldset">
          <legend>{g.label}</legend>
          <div class="checks">
            {g.items.map((a) => (
              <label class="label">
                <input class="input" type="checkbox" name="am" value={a.key} /> {a.label}
              </label>
            ))}
          </div>
        </fieldset>
      ))
    )
  }
</div>
