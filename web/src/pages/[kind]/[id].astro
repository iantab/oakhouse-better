---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Chevron from '../../components/Chevron.astro';
import { categoryLabel, getData, operatorOf, yen } from '../../lib/data';
import type { Property, Room } from '../../lib/types';

export function getStaticPaths() {
  return getData().properties.map((p) => ({
    params: { kind: p.kind, id: String(p.id) },
    props: { p },
  }));
}

const { p } = Astro.props as { p: Property };
const base = import.meta.env.BASE_URL;
const { amenities, lines } = getData();
const amenityLabel = new Map(amenities.items.map((a) => [a.key, a]));
const lineName = new Map(lines.map((l) => [l.id, l]));

const STATUS: Record<Room['status'], string> = { available: 'Available', soon: 'Soon', full: 'Full' };
const statusRank = { available: 0, soon: 1, full: 2 } as const;
const rooms = [...p.rooms].sort(
  (a, b) => statusRank[a.status] - statusRank[b.status] || (a.monthly_total ?? a.rent ?? 0) - (b.monthly_total ?? b.rent ?? 0),
);
const open = rooms.filter((r) => r.status !== 'full');
const statusCount = (s: Room['status']) => rooms.filter((r) => r.status === s).length;
const soonCount = statusCount('soon');
const fullCount = statusCount('full');
const prices = rooms.map((r) => r.monthly_total ?? r.rent).filter((n): n is number => n != null);

const op = operatorOf(p);
const g = p.geo;
const address = g?.chome
  ? [g.chome, p.ward ?? g.ward, p.prefecture ?? g.prefecture].filter(Boolean).join(', ') + (g.postcode ? ` ${g.postcode}` : '')
  : p.address + (p.postcode ? ` ${p.postcode}` : '');
// Xross apartment buildings are grouped from one listing per unit; each unit keeps its own page
const unitPages = rooms.some((r) => r.url && r.url !== p.url);

const propertyChips = p.amenities.map((k) => amenityLabel.get(k)).filter((a) => a != null);
const roomKeys = (r: Room) => r.amenities.filter((k) => amenityLabel.get(k)?.group === 'room');
// Features every room shares are listed once above the table; each row shows only what differs.
const commonKeys = rooms.length
  ? roomKeys(rooms[0]).filter((k) => rooms.every((r) => r.amenities.includes(k)))
  : [];
const roomChips = (r: Room) =>
  roomKeys(r).filter((k) => !commonKeys.includes(k)).map((k) => amenityLabel.get(k)!);

const photos = p.photos.length >= 3 ? p.photos : [...p.photos, ...rooms.flatMap((r) => r.photos.slice(0, 1).map((src) => ({ src, caption: `Room ${r.number}` })))];

// Google Maps for everyday use (OSM is only our station data source). The output=embed URL needs no API key.
const hasCoords = p.lat != null && p.lng != null;
const mapUrl = hasCoords ? `https://maps.google.com/maps?q=${p.lat},${p.lng}&z=16&hl=en&output=embed` : null;
const googleMapsUrl = hasCoords ? `https://www.google.com/maps/search/?api=1&query=${p.lat},${p.lng}` : null;
const areaHref = (depth: number) => `${base}conditions/?area=${p.area_path.slice(0, depth + 1).join('/')}`;
const areaNames = [p.prefecture, p.region, p.ward];
// Skip a breadcrumb level that repeats its parent's name ("Saitama › Saitama")
const crumbs = p.area_path
  .map((_, i) => ({ name: areaNames[i], href: areaHref(i) }))
  .filter((c, i, all) => c.name && (i === 0 || c.name !== all[i - 1].name));
const fees = (r: Room) =>
  Object.entries(r.fees ?? {}).filter(([k]) => /Key money|Security deposit|Brokerage|Estimated initial cost/.test(k));
---

<Base title={p.name} description={`${categoryLabel(p.category)} in ${p.ward ?? p.prefecture ?? 'Japan'}: ${p.rooms.length} rooms, from ${yen(Math.min(...prices))}/month.`}>
  <Breadcrumb items={[{ label: 'Home', href: base }, ...crumbs.map((c) => ({ label: c.name!, href: c.href })), { label: p.name, current: true }]} />

  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="kind">{categoryLabel(p.category)} · {op.name}</p>
      <h1 class="text-3xl font-bold tracking-tight">{p.name}</h1>
      <p class="mt-1 text-muted-foreground">{address}</p>
    </div>
    <div class="price-box">
      <p class="text-sm text-muted-foreground">Monthly, incl. maintenance</p>
      <p class="text-2xl font-bold tracking-tight tabular-nums">{prices.length ? `${yen(Math.min(...prices))}${Math.max(...prices) !== Math.min(...prices) ? ` – ${yen(Math.max(...prices))}` : ''}` : '—'}</p>
      <p class="text-sm"><strong>{open.length}</strong> of {p.rooms.length} room{p.rooms.length === 1 ? '' : 's'} available or soon</p>
    </div>
  </div>

  {
    photos.length > 0 && (
      <div class="gallery">
        {photos.slice(0, 12).map((ph) => (
          <figure>
            <img src={ph.src} alt={ph.caption || p.name} loading="lazy" referrerpolicy="no-referrer" />
            {ph.caption && <figcaption>{ph.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }

  <div class="detail-grid">
    <div class="flex min-w-0 flex-col gap-4">
      <section class="card rooms-panel">
        <header>
          <h2>Rooms</h2>
          {commonKeys.length > 0 && <p>{rooms.length > 1 ? 'Every room has:' : 'Room features:'}</p>}
        </header>
        <section class="flex flex-col gap-4">
          {commonKeys.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">{commonKeys.map((k) => <li class="badge" data-variant="secondary">{amenityLabel.get(k)!.label}</li>)}</ul>
          )}
          {/* Hiding is CSS-only (.rooms-panel:has(...) in global.css); the script below just updates the count. */}
          {(soonCount > 0 || fullCount > 0) && (
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <span class="text-sm text-muted-foreground">Show:</span>
              {soonCount > 0 && (
                <label class="label"><input class="input" type="checkbox" id="show-soon" checked /> Soon <span class="count">({soonCount})</span></label>
              )}
              {fullCount > 0 && (
                <label class="label"><input class="input" type="checkbox" id="show-full" /> Full <span class="count">({fullCount})</span></label>
              )}
              <span class="room-count ms-auto text-sm text-muted-foreground" data-total={rooms.length}></span>
            </div>
          )}
          <div class="table-container rooms-scroll">
            <table class="table">
              <thead>
                <tr>
                  <th>Status</th><th>Room</th><th>Type</th><th class="num">Size</th><th class="num">Floor</th>
                  <th class="num">Rent</th><th class="num">Maint.</th><th class="num">Monthly</th><th class="features">Also has</th>
                </tr>
              </thead>
              <tbody>
                {
                  rooms.map((r) => (
                    <tr class={r.status === 'full' ? 'is-full' : undefined} data-status={r.status}>
                      <td>
                        <span class={`badge status-${r.status}`}>{STATUS[r.status]}</span>
                        {r.available_from && <div class="text-xs whitespace-nowrap text-muted-foreground">from {r.available_from}</div>}
                      </td>
                      <td>
                        {unitPages && r.url
                          ? <a class="link" href={r.url} target="_blank" rel="noopener"><strong>{r.number}</strong></a>
                          : <strong>{r.number}</strong>}
                        {r.photos.length > 0 && (
                          <div class="room-photos">
                            {r.photos.slice(0, 1).map((src) => <img src={src} alt={`Room ${r.number}`} loading="lazy" referrerpolicy="no-referrer" />)}
                          </div>
                        )}
                      </td>
                      <td>
                        {r.room_type}
                        {r.floor_plan && <div class="text-xs text-muted-foreground">{r.floor_plan}</div>}
                        {r.gender !== 'any' && <div class="text-xs font-medium">{r.gender === 'women' ? 'Women only' : 'Men only'}</div>}
                      </td>
                      <td class="num">{r.size_m2 != null ? `${r.size_m2}㎡` : '—'}</td>
                      <td class="num">{r.floor != null ? `${r.floor}F` : '—'}</td>
                      <td class="num">{yen(r.rent)}</td>
                      <td class="num">{yen(r.maintenance)}</td>
                      <td class="num"><strong>{yen(r.monthly_total ?? r.rent)}</strong></td>
                      <td class="features">
                        <ul class="flex flex-wrap gap-1">{roomChips(r).map((a) => <li class="badge" data-variant="outline">{a.label}</li>)}</ul>
                        {fees(r).length > 0 && (
                          <div class="mt-1.5 text-xs text-muted-foreground">{fees(r).map(([k, v]) => `${k}: ${v.replace(/※.*$/, '').trim()}`).join(' · ')}</div>
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="rooms-empty text-muted-foreground" hidden>
            {open.length === 0
              ? <>All rooms here are full right now. Tick <strong>Full</strong> above to see them.</>
              : <>No rooms are available right now. Tick <strong>Soon</strong> above to see upcoming rooms.</>}
          </p>
        </section>
        {rooms.some((r) => r.contract_fee) && (
          <footer>
            <p class="text-muted-foreground">One-time {p.operator === 'xross' ? 'registration' : 'contract'} fee: {[...new Set(rooms.map((r) => r.contract_fee).filter(Boolean))].map((n) => yen(n)).join(' / ')}.</p>
          </footer>
        )}
      </section>

      {p.description && (
        <section class="card">
          <header><h2>About this property</h2></header>
          <section><p class="leading-relaxed">{p.description}</p></section>
        </section>
      )}

      <section class="card">
        <header><h2>Shared facilities</h2></header>
        <section>
          {Object.keys(p.shared_facilities).length === 0 && <p class="text-muted-foreground">None listed.</p>}
          <dl class="facts">
            {Object.entries(p.shared_facilities).map(([cat, items]) => (
              <>
                <dt>{cat}</dt>
                <dd>{items.map((i) => i.label).join(', ')}</dd>
              </>
            ))}
          </dl>
        </section>
      </section>
    </div>

    <div class="flex min-w-0 flex-col gap-4">
      <section class="card">
        <section class="flex flex-col gap-3">
          <a class="btn w-full" data-size="lg" href={p.url} target="_blank" rel="noopener">View &amp; apply on {op.site} ↗</a>
          {unitPages && <p class="text-xs text-muted-foreground">Each unit has its own page on {op.site}: click a room number.</p>}
          {p.updated && <p class="text-xs text-muted-foreground">Last updated by {op.name}: {p.updated}</p>}
        </section>
      </section>

      <section class="card">
        <header>
          <h2>Getting there</h2>
          {p.terminal && <p>{p.terminal}</p>}
        </header>
        <section class="flex flex-col gap-4">
          {mapUrl && <iframe class="map" src={mapUrl} title={`Map of ${p.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" />}
          {googleMapsUrl && (
            <a class="btn" data-variant="outline" data-size="sm" href={googleMapsUrl} target="_blank" rel="noopener">Open in Google Maps ↗</a>
          )}
          {
            p.stations.length > 0 ? (
              <table class="table">
                <thead><tr><th>Station</th><th class="num">Walk*</th></tr></thead>
                <tbody>
                  {p.stations.slice(0, 6).map((s) => (
                    <tr>
                      <td>
                        {s.name}
                        <div class="text-xs text-muted-foreground">{s.lines.map((id) => lineName.get(id)?.name ?? id).join(', ')}</div>
                      </td>
                      <td class="num">{s.walk_min} min<div class="text-xs text-muted-foreground">{s.distance_m} m</div></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : null
          }
          {p.stations.length > 0 && <p class="text-xs text-muted-foreground">*Estimated from straight-line distance (80 m/min, +25% for streets).</p>}
          {
            p.operator_stations.length > 0 && (
              <div class="accordion">
                <details open={p.stations.length === 0}>
                  <summary>
                    {op.name}'s station list
                    <Chevron />
                  </summary>
                  <section>
                    <ul class="list-disc space-y-1 ps-5">
                      {p.operator_stations.map((s) => (
                        <li>{s.station} ({s.line}){s.walk_min != null && ` – ${s.walk_min} min walk`}</li>
                      ))}
                    </ul>
                  </section>
                </details>
              </div>
            )
          }
        </section>
      </section>

      {propertyChips.length > 0 && (
        <section class="card">
          <header>
            <h2>Building &amp; contract</h2>
            {p.discounts.length > 0 && <p>Discounts: {p.discounts.join(', ')}</p>}
          </header>
          <section>
            <ul class="flex flex-wrap gap-1.5">{propertyChips.map((a) => <li class="badge" data-variant="secondary">{a!.label}</li>)}</ul>
          </section>
        </section>
      )}

      {Object.keys(p.building).length > 0 && (
        <section class="card">
          <header><h2>Building info</h2></header>
          <section>
            <dl class="facts stacked">
              {Object.entries(p.building).filter(([, v]) => v).map(([k, v]) => (
                <>
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </>
              ))}
            </dl>
          </section>
        </section>
      )}
    </div>
  </div>
</Base>

<script>
  // Rows are hidden by CSS; this only keeps the "Showing X of N" text and empty state in sync.
  const panel = document.querySelector<HTMLElement>('.rooms-panel');
  if (panel) {
    const count = panel.querySelector<HTMLElement>('.room-count');
    const empty = panel.querySelector<HTMLElement>('.rooms-empty')!;
    const update = () => {
      const rows = [...panel.querySelectorAll<HTMLElement>('tbody tr[data-status]')];
      const shown = rows.filter((r) => getComputedStyle(r).display !== 'none').length;
      if (count) count.textContent = `Showing ${shown} of ${count.dataset.total} rooms`;
      empty.hidden = shown > 0;
    };
    panel.addEventListener('change', update);
    update();
  }
</script>
