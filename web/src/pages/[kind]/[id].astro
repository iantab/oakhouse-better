---
// One page per building, built only from facts (prices, sizes, stations, amenities, terms). The operators'
// photos and descriptions are theirs, so each room links to its own page on the operator's site instead.
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getBuilding, getBuildings, getData } from '../../lib/data';
import { CATEGORY_LABELS, OPERATORS } from '../../lib/filter';
import type { Building, BuildingRoom } from '../../lib/types';

export function getStaticPaths() {
  return getBuildings().map((b) => ({ params: { kind: b.kind, id: String(b.id) } }));
}

const found = getBuilding(Astro.params.id!);
if (!found) return Astro.redirect(`${import.meta.env.BASE_URL}404/`);
const b: Building = found;
const base = import.meta.env.BASE_URL;
const { amenities, lines } = getData();
const amenityLabel = Object.fromEntries(amenities.items.map((a) => [a.key, a.label]));
const amenityGroup = Object.fromEntries(amenities.items.map((a) => [a.key, a.group]));
const lineName = Object.fromEntries(lines.map((l) => [l.id, l.name]));
/** A station's line names: OSM's direction variants ("… Line (up)") merged, at most 5 shown. */
const lineList = (ids: string[]) => {
  const names = [...new Set(ids.map((id) => lineName[id]?.replace(/\s*\((up|down|inbound|outbound)\)$/i, '')).filter(Boolean))];
  return names.slice(0, 5).join(' · ') + (names.length > 5 ? ` · +${names.length - 5} more` : '');
};

const op = OPERATORS[b.o];
const per30 = b.o === 'l';
const period = per30 ? '30 days' : 'month';
const yen = (n: number | null | undefined) => (n == null ? '—' : `¥${n.toLocaleString('en-US')}`);
const STATUS = { available: 'Available', soon: 'Soon', full: 'Full' } as const;
const STRUCTURE = { wood: 'Wood', steel: 'Steel frame', rc: 'Reinforced concrete' } as const;

const rooms = b.rooms ?? []; // stale data from before zero-room buildings were skipped can lack the key
const open = rooms.filter((r) => r.status !== 'full');
const prices = (open.length ? open : rooms).map((r) => r.total ?? r.rent).filter((n): n is number => n != null);
const from = prices.length ? Math.min(...prices) : null;
const hasFull = rooms.some((r) => r.status === 'full');
const hasFloor = rooms.some((r) => r.floor != null);
const hasSize = rooms.some((r) => r.size != null);

const mapsUrl = b.lat != null ? `https://www.google.com/maps/search/?api=1&query=${b.lat},${b.lng}` : null;
const embedUrl = b.lat != null ? `https://maps.google.com/maps?q=${b.lat},${b.lng}&z=16&output=embed&hl=en` : null;

// Keys that only make sense as a search filter, not as a fact chip (the "Pay upfront only" badge covers this one)
const FILTER_ONLY = new Set(['pay_monthly']);
const chips = (keys?: string[]) => (keys ?? []).filter((k) => !FILTER_ONLY.has(k));
const shared = chips(b.amenities);
const amenityGroups = [
  { title: 'Building', keys: shared.filter((k) => amenityGroup[k] === 'building') },
  { title: 'Contract', keys: shared.filter((k) => amenityGroup[k] === 'contract') },
  { title: 'Every room', keys: shared.filter((k) => amenityGroup[k] === 'room') },
].filter((g) => g.keys.length);

const facts: [string, string][] = [
  ...(b.structure ? [['Structure', STRUCTURE[b.structure]] as [string, string]] : []),
  ...(b.built ? [['Year built', String(b.built)] as [string, string]] : []),
  ...(b.facts ?? []).filter(([k]) => k !== 'Structure'),
];

// Breadcrumb: the area path links to results for that area
const areaNames = [b.prefecture, b.region, b.ward];
const crumbs = (b.area ?? [])
  .map((slug, i, path) => ({ label: areaNames[i] ?? slug, href: `${base}results/?area=${path.slice(0, i + 1).join('/')}` }))
  .filter((c, i, all) => i === 0 || c.label !== all[i - 1].label);

// LIFULL's stay-length plans are often identical; only show the table when staying longer changes something
const plansDiffer = (r: BuildingRoom) => new Set((r.plans ?? []).map(([, d, c]) => `${d}/${c}`)).size > 1;
const roomDetails = (r: BuildingRoom) =>
  Boolean(chips(r.am).length || r.fees?.length || plansDiffer(r) || r.beds?.length || r.plan || r.occ);
const description = `${CATEGORY_LABELS[b.category] ?? b.category} in ${b.ward ?? b.prefecture ?? 'Japan'}: ${rooms.length} room${rooms.length === 1 ? '' : 's'}${from != null ? `, from ${yen(from)} per ${period}` : ''}.`;
---

<Base title={b.name} description={description}>
  <Breadcrumb items={[{ label: 'Home', href: base }, ...crumbs, { label: b.name, current: true }]} />

  <div class="building-layout">
    <div class="flex min-w-0 flex-col gap-4">
      <section class="card">
        <header>
          <p class="kind">{CATEGORY_LABELS[b.category] ?? b.category} · {op.name}{b.ward ? ` · ${b.ward}` : ''}</p>
          <h1>{b.name}</h1>
          {b.name_ja && <p class="text-base text-muted-foreground" lang="ja">{b.name_ja}</p>}
          {
            (b.address || b.address_ja) && (
              <p class="mt-1 text-sm text-muted-foreground">
                {b.address}
                {b.address_ja && (
                  <span class="block" lang="ja">
                    {b.postcode && `〒${b.postcode} `}
                    {b.address_ja}
                  </span>
                )}
              </p>
            )
          }
        </header>
        <section class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm text-muted-foreground">{open.length ? 'Available rooms from' : 'Rooms from'}</p>
            <p class="text-3xl font-semibold tabular-nums">{yen(from)}<span class="text-base font-normal text-muted-foreground"> / {period}</span></p>
            <p class="text-sm text-muted-foreground">
              {rooms.length} room{rooms.length === 1 ? '' : 's'} · {open.length} available or soon
            </p>
          </div>
          <div class="flex flex-wrap gap-2">
            {
              b.ext && (
                <a class="btn" href={b.ext} target="_blank" rel="noopener">
                  View on {op.site}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
                </a>
              )
            }
            {
              mapsUrl && (
                <a class="btn" data-variant="outline" href={mapsUrl} target="_blank" rel="noopener">
                  Open in Google Maps
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
                </a>
              )
            }
          </div>
        </section>
      </section>

      <section class="card rooms-panel">
        <header class="flex flex-row flex-wrap items-center justify-between gap-2">
          <div>
            <h2>Rooms</h2>
            <p>
              Each room opens on {op.site}, with photos and full details.{per30 && ' Prices are for 30 days, including utilities.'}
            </p>
          </div>
          {
            hasFull && (
              <label class="label text-sm">
                <input class="input" type="checkbox" id="show-full" /> Show full rooms
              </label>
            )
          }
        </header>
        <section>
          <div class="table-container">
            <table class="table room-table">
              <thead>
                <tr>
                  <th>Status</th>
                  <th>Room</th>
                  <th class="num">{per30 ? '30 days' : 'Monthly'}</th>
                  {hasSize && <th class="num">Size</th>}
                  {hasFloor && <th class="num">Floor</th>}
                  <th class="opt">Type</th>
                </tr>
              </thead>
              {
                rooms.map((r) => (
                  <tbody data-status={r.status} class={r.status === 'full' ? 'is-full' : undefined}>
                    <tr>
                      <td>
                        <span class={`badge status-${r.status}`}>{STATUS[r.status]}</span>
                        {r.status === 'soon' && r.from && <div class="text-xs whitespace-nowrap text-muted-foreground">from {r.from}</div>}
                      </td>
                      <td>
                        <a class="unit-link" href={r.url} target="_blank" rel="noopener">
                          {r.number}
                          <svg class="ext-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
                        </a>
                        {r.gender && <div class="mt-1"><span class={`badge gender-${r.gender}`}>{r.gender === 'women' ? 'Women only' : 'Men only'}</span></div>}
                        {r.pu && <div class="mt-1"><span class="badge pay-upfront">Pay upfront only</span></div>}
                      </td>
                      <td class="num">
                        <strong>{yen(r.total ?? r.rent)}</strong>
                        {r.rent != null && r.total != null && r.total !== r.rent && (
                          <div class="text-xs text-muted-foreground">rent {yen(r.rent)} + {yen(r.maint)}</div>
                        )}
                      </td>
                      {hasSize && <td class="num">{r.size != null ? `${r.size}㎡` : '—'}</td>}
                      {hasFloor && <td class="num">{r.floor != null ? `${r.floor}F` : '—'}</td>}
                      <td class="opt">{r.type ?? ''}</td>
                    </tr>
                    {roomDetails(r) && (
                      <tr class="room-more">
                        <td colspan={4 + (hasSize ? 1 : 0) + (hasFloor ? 1 : 0)}>
                          <details>
                            <summary>Room details</summary>
                            <div class="room-detail">
                              {(r.plan || r.occ || r.beds?.length || r.fee != null) && (
                                <dl class="facts">
                                  {r.plan && (<><dt>Floor plan</dt><dd>{r.plan}</dd></>)}
                                  {r.occ && (<><dt>Max occupancy</dt><dd>{r.occ} {r.occ === 1 ? 'person' : 'people'}</dd></>)}
                                  {!!r.beds?.length && (<><dt>Beds</dt><dd>{r.beds.join(', ')}</dd></>)}
                                  {r.fee != null && (<><dt>{per30 ? 'Initial cost' : 'Contract fee'}</dt><dd>{yen(r.fee)}{per30 && ' (cleaning etc., on top of the first 30 days)'}</dd></>)}
                                </dl>
                              )}
                              {chips(r.am).length > 0 && (
                                <ul class="chips">
                                  {chips(r.am).map((k) => <li><span class="badge" data-variant="secondary">{amenityLabel[k] ?? k}</span></li>)}
                                </ul>
                              )}
                              {plansDiffer(r) && (
                                <table class="table plans">
                                  <thead><tr><th>Stay</th><th class="num">Discount</th><th class="num">Cleaning fee</th></tr></thead>
                                  <tbody>
                                    {r.plans!.map(([stay, discount, cleaning]) => (
                                      <tr><td>{stay}</td><td class="num">{discount ? `−${yen(discount)} / day` : '—'}</td><td class="num">{yen(cleaning)}</td></tr>
                                    ))}
                                  </tbody>
                                </table>
                              )}
                              {!!r.fees?.length && (
                                <dl class="facts">
                                  {r.fees.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
                                </dl>
                              )}
                            </div>
                          </details>
                        </td>
                      </tr>
                    )}
                  </tbody>
                ))
              }
            </table>
          </div>
        </section>
      </section>

      {
        amenityGroups.length > 0 && (
          <section class="card">
            <header>
              <h2>Amenities</h2>
              <p>Shared by every room here. Room-specific ones are under each room's details.</p>
            </header>
            <section class="flex flex-col gap-4">
              {amenityGroups.map((g) => (
                <div>
                  <h3 class="mb-2 text-sm font-medium text-muted-foreground">{g.title}</h3>
                  <ul class="chips">
                    {g.keys.map((k) => <li><span class="badge" data-variant="secondary">{amenityLabel[k] ?? k}</span></li>)}
                  </ul>
                </div>
              ))}
            </section>
          </section>
        )
      }

      {
        facts.length > 0 && (
          <section class="card">
            <header><h2>Building</h2></header>
            <section>
              <dl class="facts">
                {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
              </dl>
            </section>
          </section>
        )
      }
    </div>

    <aside class="flex min-w-0 flex-col gap-4">
      {
        embedUrl && (
          <section class="card overflow-hidden py-0">
            <iframe class="map-embed" src={embedUrl} title={`Map of ${b.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </section>
        )
      }

      {
        (b.stations?.length ?? 0) > 0 && (
          <section class="card" data-size="sm">
            <header><h2>Nearest stations</h2></header>
            <section>
              <ul class="flex flex-col gap-3">
                {b.stations!.map(([name, walk, lineIds]) => (
                  <li>
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="font-medium">{name}</span>
                      {walk != null && <span class="text-sm whitespace-nowrap text-muted-foreground tabular-nums">{walk} min walk</span>}
                    </div>
                    {lineIds.length > 0 && (
                      <p class="text-xs text-muted-foreground">{lineList(lineIds)}</p>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          </section>
        )
      }

      {
        ((b.terms?.length ?? 0) > 0 || (b.discounts?.length ?? 0) > 0) && (
          <section class="card" data-size="sm">
            <header><h2>Terms &amp; offers</h2></header>
            <section class="flex flex-col gap-3 text-sm">
              {!!b.terms?.length && (
                <ul class="list-disc pl-5">{b.terms.map((t) => <li>{t}</li>)}</ul>
              )}
              {!!b.discounts?.length && (
                <div>
                  <h3 class="mb-1 font-medium text-muted-foreground">Discounts</h3>
                  <ul class="list-disc pl-5">{b.discounts.map((d) => <li>{d}</li>)}</ul>
                </div>
              )}
            </section>
          </section>
        )
      }
    </aside>
  </div>
</Base>
