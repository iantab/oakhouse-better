---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Chevron from '../../components/Chevron.astro';
import { getData } from '../../lib/data';
import { groupTokyo } from '../../lib/tokyo';

const base = import.meta.env.BASE_URL;
const { areas } = getData();
const fmt = (n: number) => n.toLocaleString('en-US');
---

<Base title="Search by area">
  <Breadcrumb
    items={[
      { label: 'Home', href: base },
      { label: '1. Choose areas', current: true },
      { label: '2. Conditions' },
      { label: '3. Results' },
    ]}
  />

  {/*
    Checkboxes named "area" are submitted (prefecture / region / ward paths). Boxes with data-children
    are name-less "select all" helpers (Tokyo 23-ward groups). Parent and helper states are derived
    from the wards by the script below.
  */}
  <form class="card form-card" method="get" action={`${base}conditions/`} id="area-form">
    <header>
      <h1>Where do you want to live?</h1>
      <p>Tick a whole prefecture or region, or open it to pick individual wards and cities. Numbers are rooms listed.</p>
    </header>
    <section>
      <div class="accordion">
        {
          areas.map((pref, i) => (
            <details open={i === 0}>
              <summary>
                <label class="label">
                  <input class="input" type="checkbox" name="area" value={pref.slug} />
                  {pref.name} <span class="count">{fmt(pref.units)}</span>
                </label>
                <Chevron />
              </summary>
              <section class="flex flex-col gap-6 ps-6">
                {pref.slug === 'tokyo' ? (
                  (() => {
                    const { wards23, rest } = groupTokyo(pref);
                    const paths = (ws: { path: string }[]) => ws.map((w) => w.path).join(' ');
                    return (
                      <>
                        {wards23.groups.length > 0 && (
                          <fieldset class="fieldset">
                            <legend>
                              <label class="label">
                                <input class="input" type="checkbox" data-children={paths(wards23.groups.flatMap((g) => g.wards))} />
                                Tokyo 23 wards <span class="count">{fmt(wards23.units)}</span>
                              </label>
                            </legend>
                            {wards23.groups.map((g) => (
                              <div class="flex flex-col gap-3 ps-6">
                                <label class="label">
                                  <input class="input" type="checkbox" data-children={paths(g.wards)} />
                                  {g.name} <span class="count">{fmt(g.units)}</span>
                                </label>
                                <div class="checks ps-6">
                                  {g.wards.map((w) => (
                                    <label class="label font-normal">
                                      <input class="input" type="checkbox" name="area" value={w.path} />
                                      {w.name} <span class="count">{fmt(w.units)}</span>
                                    </label>
                                  ))}
                                </div>
                              </div>
                            ))}
                          </fieldset>
                        )}
                        {rest.wards.length > 0 && (
                          <fieldset class="fieldset">
                            <legend>
                              <label class="label">
                                <input class="input" type="checkbox" data-children={paths(rest.wards)} />
                                Rest of Tokyo (Tama area) <span class="count">{fmt(rest.units)}</span>
                              </label>
                            </legend>
                            <div class="checks ps-6">
                              {rest.wards.map((w) => (
                                <label class="label font-normal">
                                  <input class="input" type="checkbox" name="area" value={w.path} />
                                  {w.name} <span class="count">{fmt(w.units)}</span>
                                </label>
                              ))}
                            </div>
                          </fieldset>
                        )}
                      </>
                    );
                  })()
                ) : (
                  pref.children.map((region) => (
                    <fieldset class="fieldset">
                      <legend>
                        <label class="label">
                          <input class="input" type="checkbox" name="area" value={`${pref.slug}/${region.slug}`} />
                          {region.name} <span class="count">{fmt(region.units)}</span>
                        </label>
                      </legend>
                      {region.children.length > 0 && (
                        <div class="checks ps-6">
                          {region.children.map((ward) => (
                            <label class="label font-normal">
                              <input class="input" type="checkbox" name="area" value={`${pref.slug}/${region.slug}/${ward.slug}`} />
                              {ward.name} <span class="count">{fmt(ward.units)}</span>
                            </label>
                          ))}
                        </div>
                      )}
                    </fieldset>
                  ))
                )}
              </section>
            </details>
          ))
        }
      </div>
      {areas.length === 0 && <p class="text-muted-foreground">No listing data yet. Run the scraper or <code>npm run data:pull</code>.</p>}
    </section>
    <footer class="sticky-submit border-t">
      <button class="btn" type="submit">Next: set conditions</button>
      <span class="text-sm text-muted-foreground" id="area-summary">No areas selected (searches everywhere)</span>
    </footer>
  </form>
</Base>

<script>
  const form = document.getElementById('area-form') as HTMLFormElement;
  const summary = document.getElementById('area-summary')!;
  const areaBoxes = [...form.querySelectorAll<HTMLInputElement>('input[name="area"]')];
  const helpers = [...form.querySelectorAll<HTMLInputElement>('input[data-children]')];
  const isUnder = (child: string, parent: string) => child.startsWith(parent + '/');
  // Leaf = an area box with no deeper area box rendered (a ward/city, or a region without wards).
  const leaves = areaBoxes.filter((b) => !areaBoxes.some((o) => isUnder(o.value, b.value)));
  const leafByPath = new Map(leaves.map((b) => [b.value, b]));

  const leavesOf = (box: HTMLInputElement) =>
    box.dataset.children !== undefined
      ? box.dataset.children.split(' ').map((p) => leafByPath.get(p)).filter((b): b is HTMLInputElement => !!b)
      : leaves.filter((l) => l === box || isUnder(l.value, box.value));

  // Parents and helpers reflect their leaves: all ticked → checked, some → indeterminate.
  function syncParents() {
    for (const box of [...areaBoxes, ...helpers]) {
      const ls = leavesOf(box);
      if (ls.length === 1 && ls[0] === box) continue;
      const on = ls.filter((l) => l.checked).length;
      box.checked = ls.length > 0 && on === ls.length;
      box.indeterminate = on > 0 && on < ls.length;
    }
  }

  // The most general ticked selections, i.e. what actually gets submitted.
  const submitted = () =>
    areaBoxes.filter((b) => b.checked && !areaBoxes.some((p) => p !== b && p.checked && isUnder(b.value, p.value)));

  form.addEventListener('change', (e) => {
    const box = e.target as HTMLInputElement;
    if (box.name !== 'area' && box.dataset.children === undefined) return;
    for (const leaf of leavesOf(box)) leaf.checked = box.checked;
    syncParents();
    const n = submitted().length;
    summary.textContent = n ? `${n} area${n > 1 ? 's' : ''} selected` : 'No areas selected (searches everywhere)';
  });

  // Submit only the most general selections: a ticked parent makes its ticked children redundant.
  form.addEventListener('submit', () => {
    const keep = new Set(submitted());
    for (const b of areaBoxes) if (b.checked && !keep.has(b)) b.disabled = true;
  });
  window.addEventListener('pageshow', () => {
    areaBoxes.forEach((b) => (b.disabled = false));
    syncParents(); // back/forward cache restores ticks; recompute partial states
  });
</script>
