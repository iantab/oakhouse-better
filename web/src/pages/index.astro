---
import Base from '../layouts/Base.astro';
import { getData } from '../lib/data';

const base = import.meta.env.BASE_URL;
const { meta, areas } = getData();
const fmt = (n: number) => n.toLocaleString('en-US');
---

<Base>
  <section class="max-w-2xl pt-6 pb-2">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Find a furnished room in Japan</h1>
    <p class="mt-4 text-lg text-muted-foreground">
      Every share house, social residence and furnished apartment from Oakhouse and Xross House in one search:
      pick where you want to live, then narrow it down by price, room and building.
    </p>
  </section>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <a class="card tile" href={`${base}search/area/`}>
      <header>
        <span class="tile-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        </span>
        <h2>Search by area</h2>
        <p>Choose a prefecture, then the wards and cities you like.</p>
      </header>
    </a>
    <a class="card tile" href={`${base}search/line/`}>
      <header>
        <span class="tile-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="14" rx="3"/><path d="M5 11h14M9 21l-2-4M15 21l2-4"/><circle cx="9" cy="14" r=".5"/><circle cx="15" cy="14" r=".5"/></svg>
        </span>
        <h2>Search by line &amp; station</h2>
        <p>Pick train lines and stations, then set how far you'll walk.</p>
      </header>
    </a>
    <a class="card tile" href={`${base}search/commute/`}>
      <header>
        <span class="tile-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </span>
        <h2>Search by commute time</h2>
        <p>Pick the station you travel to and how long you'll ride.</p>
      </header>
    </a>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {[
      [meta.properties, 'Properties'],
      [meta.units, 'Rooms & units'],
      [meta.available, 'Available now or soon'],
    ].map(([n, label]) => (
      <div class="card" data-size="sm">
        <header>
          <p>{label}</p>
          <h2 class="text-2xl! font-semibold tabular-nums">{fmt(n as number)}</h2>
        </header>
      </div>
    ))}
  </div>

  {
    areas.length > 0 && (
      <section class="card mt-4">
        <header>
          <h2>Jump to a prefecture</h2>
          <p>Rooms listed in each.</p>
        </header>
        <section>
          <ul class="flex flex-wrap gap-2">
            {areas.map((a) => (
              <li>
                <a class="badge" data-variant="outline" href={`${base}conditions/?area=${a.slug}`}>
                  {a.name} <span class="text-muted-foreground tabular-nums">{fmt(a.units)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </section>
    )
  }
</Base>
