---
// GitHub Pages serves this for any unknown path, e.g. a building that is no longer listed.
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Page not found">
  <section class="empty border">
    <header>
      <h1 class="text-2xl font-semibold tracking-tight">Page not found</h1>
      <p>
        This page doesn't exist, or the listing is no longer advertised. Try searching again.
      </p>
    </header>
    <section class="flex flex-wrap justify-center gap-2">
      <a class="btn" href={`${base}search/area/`}>Search by area</a>
      <a class="btn" data-variant="outline" href={base}>Home</a>
    </section>
  </section>
</Base>
